import sounddevice as sd
import numpy as np
import time

class QuickVoiceFeedback:
    def __init__(self):
        self.sample_rate = 44100
        self.delay_samples = 100  # ~1 sec delay
        self.buffer = np.zeros(self.delay_samples)
        self.index = 0
        self.running = True
        
    def callback(self, indata, outdata, frames, time_info, status):
        audio = indata[:, 0]
        # Add delay
        output = np.zeros_like(audio)
        for i in range(len(audio)):
            output[i] = self.buffer[self.index]
            self.buffer[self.index] = audio[i] * 0.7
            self.index = (self.index + 1) % self.delay_samples
        outdata[:, 0] = output
    
    def run(self):
        with sd.Stream(callback=self.callback, channels=1, samplerate=self.sample_rate):
            print("Voice feedback active. Press Ctrl+C to stop.")
            print("Adjust delay by changing 'self.delay_samples' in code.")
            while self.running:
                time.sleep(0.1)

if __name__ == "__main__":
    qvf = QuickVoiceFeedback()
    try:
        qvf.run()
    except KeyboardInterrupt:
        print("\nStopping...")
